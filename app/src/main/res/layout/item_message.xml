<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Avatar + online dot -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/shapeImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/theme"
            android:scaleType="centerCrop"
            android:padding="2dp"
            app:strokeWidth="2dp"
            app:strokeColor="#0B1757"
            app:shapeAppearanceOverlay="@style/OvalImage"/>

        <!-- Green dot (bottom-right of avatar) -->
        <View
            android:id="@+id/onlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/online_dot"
            android:visibility="gone"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/M_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/last_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last message..."
            android:textSize="12sp"
            android:textColor="#777"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/last_m_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:01"
        android:textSize="11sp"
        android:textColor="#999"/>

</LinearLayout>