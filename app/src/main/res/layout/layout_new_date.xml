<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/new_date_back">
    <!-- ===================setNewDate==================-->
    <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="20dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"/>

                <TextView
                    android:fontFamily="@font/font_family"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New To-do"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    android:textColor="#AE0303"
                    />
            </LinearLayout>

            <!-- Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Set a new date"
                app:hintTextColor="@color/black"
                android:id="@+id/dateInput"
                app:endIconMode="dropdown_menu"
                >
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/set_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:padding="9dp"
                    android:textColor="@color/black"
                    android:inputType="date"

                    />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="your blood donation number"
                app:hintTextColor="@color/black"
                android:id="@+id/number_do_input"
                android:maxEms="2"

                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/number_of_blood_given"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:inputType="number"
                    android:textColor="@color/black"
                    />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- Footer -->

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:backgroundTint="#AE0303"
                android:textColor="@color/white"/>
            <!-- ===================setNewDate==================-->
        </LinearLayout>
    </LinearLayout>
