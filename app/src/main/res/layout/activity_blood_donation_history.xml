<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Blood_Donation_history"
    android:orientation="vertical"
    android:background="#AE0303"
   >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:text="Your Donation History"
        android:textColor="@color/white"
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="@font/font_family"
        android:layout_marginTop="@dimen/_30sdp"
        />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="@dimen/_30sdp"
        app:cardBackgroundColor="@color/white"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#EEEFE5"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            android:id="@+id/for_download"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            >

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="316dp"
                android:layout_margin="@dimen/_30sdp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Donation History"
                    android:textColor="#565C3A"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:fontFamily="@font/font_family"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last donation date: "
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_family"/>

                        <TextView
                            android:id="@+id/last_donation_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_20sdp"
                            android:text="10.03.2026"
                            android:textColor="@color/black"
                            android:fontFamily="@font/font_family"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next donation date:"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_family"/>

                        <TextView
                            android:id="@+id/next_donation_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_20sdp"
                            android:text="10.03.2026"
                            android:textColor="@color/black"
                            android:fontFamily="@font/font_family"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginBottom="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ems="9"
                            android:maxLines="2"
                            android:text="Days Left for next donation: "
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_family"/>

                        <TextView
                            android:id="@+id/days_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:text="80 days"
                            android:textColor="@color/black"
                            android:fontFamily="@font/font_family"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Number of donation: "
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_family"/>

                        <TextView
                            android:id="@+id/num_of_donation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_5sdp"
                            android:text="11 th"
                            android:textColor="@color/black"
                            android:fontFamily="@font/font_family"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/download_button"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="70dp"
                    android:backgroundTint="#EEEFE5"
                    android:fontFamily="@font/font_family"
                    android:maxLines="2"
                    android:text="Download"
                    android:textColor="#565C3A" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>
</LinearLayout>