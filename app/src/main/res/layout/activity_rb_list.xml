<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".R_B_List"
    android:orientation="vertical"
    android:background="#AE0303">


    <ImageView
        android:id="@+id/backArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/backwhite"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="@dimen/_10sdp"
        />
    <TextView
        android:fontFamily="@font/font_family"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"
        android:text="Blood Seeker Information"
        android:textColor="@color/white"
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="@dimen/_10sdp"
        />
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="@dimen/_30sdp"
        app:cardBackgroundColor="@color/white"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Patient Name"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:fontFamily="@font/font_family"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/name_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:fontFamily="@font/font_family"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/email_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/phone_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Blood Group"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/group_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/gender_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Type of dieases"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/disease_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Deadline"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/deadline_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Unit blood bag"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/unit_of_blood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/location_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10"
                android:background="@drawable/divider"
                android:padding="10dp"
                >
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Hospital name"
                    android:layout_weight="4"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    />
                <TextView
                    android:id="@+id/hoapital_of_request"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Jubayer Hossain"
                    android:layout_weight="5"
                    android:textColor="@color/black"
                    />

            </LinearLayout>

            <Button
                android:id="@+id/edit_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:backgroundTint="#AE0303"
                android:text="Edit"
                android:textColor="@color/white" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>