<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".See_details"
    android:orientation="vertical"
    android:background="#AE0303">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="5dp"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="5dp"
                android:orientation="vertical"
                >
                <ImageView
                    android:id="@+id/backArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/backarrow"
                    />
                <TextView
                    android:fontFamily="@font/font_family"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Details Information"
                    android:textStyle="bold"
                    android:textSize="20dp"
                    android:gravity="center"
                    android:textColor="#0B1757"
                    android:layout_marginBottom="10dp"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Patient Name"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/name_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Phone number"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/phone_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/call"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/email_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />
                    <ImageView
                        android:id="@+id/select_person"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/m_red"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Blood Group"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/group_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Gender"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/gender_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Type of dieases"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/disease_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Deadline"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/deadline_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Unit blood bag"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/unit_of_blood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/location_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="10"
                    android:background="@drawable/divider"
                    android:padding="5dp"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Hospital name"
                        android:layout_weight="4"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/hoapital_of_request"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Jubayer Hossain"
                        android:layout_weight="5"
                        android:textColor="@color/black"
                        />
                </LinearLayout>
            </LinearLayout>
            <fragment
                android:layout_marginTop="10dp"
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="340dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>