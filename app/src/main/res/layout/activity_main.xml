<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#AE0303"
    tools:openDrawer="start"
    android:fitsSystemWindows="true"
    >
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:fitsSystemWindows="true"
        >
            <!-- ===================header==================-->

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/shapeImage"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/theme"
                android:scaleType="centerCrop"
                android:padding="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="#0B1757"
                app:shapeAppearanceOverlay="@style/OvalImage" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="5dp"
                >
                <TextView
                    android:id="@+id/Username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:fontFamily="@font/font_family"
                    android:textStyle="bold"
                    android:textSize="21dp"
                    android:textColor="#0B1757"
                    />
                <TextView
                    android:id="@+id/wish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning"
                    android:textSize="12dp"
                    android:fontFamily="@font/font_family"
                    android:textColor="#0B1757"
                    />
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fitsSystemWindows="true"
                >
                <ImageButton
                    android:id="@+id/circled_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/circledmenu"
                    android:layout_alignParentRight="true"
                    android:backgroundTint="@android:color/transparent"
                    />
            </RelativeLayout>
            <!-- ===================header==================-->
        </LinearLayout>

        <!-- ===================Body==================-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="10dp">
            <!-- ===================Activity==================-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity"
                android:textColor="#0B1757"
                android:textSize="18dp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                />
            <GridView
                android:id="@+id/grid_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="2"
                android:horizontalSpacing="8dp"
                android:verticalSpacing="8dp"
                android:stretchMode="columnWidth"
                android:layout_marginBottom="10dp"
                android:listSelector="@android:color/transparent"/>
            <!-- ===================Next Donation==================-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Donation"
                android:textColor="#0B1757"
                android:textSize="18dp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                />
            <LinearLayout
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/circle_transparent"
                android:padding="10dp"
                >
                <ImageView
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/calender"

                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/next_donation"
                    android:visibility="visible"
                    >
                    <TextView
                        android:id="@+id/date_last"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginRight="5dp"
                        android:text="Date "
                        android:textColor="#0B1757"
                        />
                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="     |     "
                        android:textColor="#0B1757"
                        />

                    <TextView
                        android:id="@+id/donation_num"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="number of dontaion"
                        android:textColor="#0B1757"
                        />
                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="     |     "
                        android:textColor="#0B1757"
                        />
                    <TextView
                        android:id="@+id/leftDays"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="left"
                        android:textColor="#0B1757"
                        />


                </LinearLayout>
                <TextView
                    android:fontFamily="@font/font_family"
                    android:id="@+id/text_donate_now"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="You can donate now ❤️ \n Give blood today—be the reason someone lives tomorrow."
                    android:textStyle="bold"
                    android:textColor="#565C3A"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- ===================Request==================-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                >
                <TextView
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request"
                    android:textColor="#0B1757"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    />
                <TextView
                    android:id="@+id/see_all"
                    android:textColor="#0B1757"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="see all"
                    android:layout_weight="1"
                    android:textAlignment="viewEnd"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/circle_transparent"
                android:padding="10dp"
                android:weightSum="2">

                <!-- LEFT SECTION -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1.5">

                    <TextView
                        android:id="@+id/location_urgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Address"
                        android:textColor="#0B1757"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/hospital_urgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hospital"
                        android:textColor="#0B1757"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blood Group : "
                            android:textColor="#0B1757"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/blood_urgent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textStyle="bold"
                            android:textColor="#AE0303"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- URGENT BUTTON -->
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:background="@drawable/footer_back"
                    android:layout_gravity="center">

                    <TextView
                        android:id="@+id/urgent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urgent"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:padding="10dp"
                        android:layout_centerInParent="true"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"/>

                </RelativeLayout>

            </LinearLayout>

            <!-- ===================Body==================-->

        </LinearLayout>
        <!-- ===================footer==================-->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:id="@+id/bottom_nav"
            android:layout_marginBottom="20dp"
            android:layout_margin="20dp"
            android:background="@drawable/footer_back"
            app:menu="@menu/footer_items" />

    </LinearLayout>
    <!-- ===================footer==================-->

</LinearLayout>
    <!-- =================navigation view=================-->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_items"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        android:background="@android:color/white"
        >
        <!-- FOOTER HOLDER -->
        <LinearLayout
            android:id="@+id/footer_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:fitsSystemWindows="true"
            >
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                />
            <include layout="@layout/nav_footer"/>
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

    <!-- =================navigation view=================-->
</androidx.drawerlayout.widget.DrawerLayout>